@@ -955,3 +955,75 @@ def test_dry_run_normalizes_settings_build_failure(
     assert diag.valid is False
     assert diag.errors
     assert diag.resolved_settings is None
+
+
+@pytest.mark.parametrize(
+    "prompt", [None, "", "Корпус: {{ verbatim }}\nUse MCP only.\n"]
+)
+def test_custom_system_prompt_survives_profile_settings_agent_roundtrip(
+    llm_store: LLMProfileStore, tmp_path: Path, prompt: str | None
+) -> None:
+    from openhands.sdk.profiles import AgentProfileStore
+    from openhands.sdk.profiles.seed import build_seed_profile
+
+    store = AgentProfileStore(base_dir=tmp_path / "agents")
+    profile = OpenHandsAgentProfile(
+        name="corpus",
+        llm_profile_ref="default",
+        system_prompt=prompt,
+        system_message_suffix="separate suffix",
+        tools=[],
+    )
+    store.save(profile)
+    loaded = store.load("corpus")
+    settings = resolve_agent_profile(
+        loaded, llm_store=llm_store, mcp_config={}, available_skills=None, cipher=None
+    )
+    assert isinstance(settings, OpenHandsAgentSettings)
+    settings = OpenHandsAgentSettings.model_validate_json(settings.model_dump_json())
+    agent = settings.create_agent()
+    assert isinstance(agent, Agent)
+    assert agent.system_prompt == prompt
+    assert agent.agent_context.system_message_suffix == "separate suffix"
+    expected = (
+        Agent(llm=settings.llm).static_system_message if prompt is None else prompt
+    )
+    assert agent.static_system_message == expected
+    # Sending a message initializes the real Canvas event without running the LLM.
+    from openhands.sdk import Conversation
+    from openhands.sdk.event import SystemPromptEvent
+    from openhands.sdk.workspace import LocalWorkspace
+
+    conversation = Conversation(
+        agent=agent,
+        workspace=LocalWorkspace(working_dir=str(tmp_path)),
+        persistence_dir=str(tmp_path / "conversation"),
+        visualizer=None,
+    )
+    try:
+        conversation.send_message("Initialize only; do not run.")
+        event = next(
+            event
+            for event in conversation.state.events
+            if isinstance(event, SystemPromptEvent)
+        )
+        assert event.system_prompt.text == expected
+        assert event.dynamic_context is not None
+        assert "separate suffix" in event.dynamic_context.text
+    finally:
+        conversation.close()
+    resumed = Agent.model_validate_json(agent.model_dump_json())
+    assert resumed.static_system_message == expected
+    assert build_seed_profile(settings, "default").system_prompt == prompt
+    # Building another profile must not inherit corpus instructions.
+    ordinary = resolve_agent_profile(
+        OpenHandsAgentProfile(name="ordinary", llm_profile_ref="default", tools=[]),
+        llm_store=llm_store,
+        mcp_config={},
+        available_skills=None,
+        cipher=None,
+    ).create_agent()
+    assert ordinary.system_prompt is None
+    assert (
+        ordinary.static_system_message == Agent(llm=settings.llm).static_system_message
+    )
