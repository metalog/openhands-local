+@pytest.mark.parametrize(
+    "prompt", [None, "", "Корпус: {{ verbatim }}\nOnly sources.\n"]
+)
+def test_custom_prompt_api_roundtrip(client, store, prompt):
+    response = client.post(
+        "/api/agent-profiles/corpus",
+        json={
+            "agent_kind": "openhands",
+            "llm_profile_ref": "test",
+            "system_prompt": prompt,
+        },
+    )
+    assert response.status_code == 201
+    loaded = client.get("/api/agent-profiles/corpus").json()["profile"]
+    assert loaded["system_prompt"] == prompt
+    assert store.load("corpus").system_prompt == prompt
+    # ACP schemas continue rejecting an OpenHands-only prompt override.
+    invalid = client.post(
+        "/api/agent-profiles/acp-prompt",
+        json={"agent_kind": "acp", "acp_server": "codex", "system_prompt": prompt},
+    )
+    assert invalid.status_code == 422
